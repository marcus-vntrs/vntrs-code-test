{
  "name": "ts-backend",
  "version": "1.0.0",
  "description": "",
  "main": "src/server.ts",
  "scripts": {
    "start": "export $(cat .env | xargs) 2>&1 1>/dev/null && node ./build/server.js",
    "dev": "export $(cat .env | xargs) && tsc-watch --onSuccess 'node --inspect --trace-warnings -r source-map-support/register ./build/server.js'",
    "build": "export $(cat .env | xargs) 2>&1 1>/dev/null && tsc --project ./",
    "test": "export $(cat .env.test | xargs) && jest --selectProjects test",
    "lint": "npx lint-staged",
    "lint:all": "eslint \"./src/**/*.ts\""
  },
  "_moduleAliases": {
    "@root": "build/",
    "@domains": "build/domains",
    "@entities": "build/entities",
    "@routes": "build/routes"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "npx eslint --fix",
      "jest --selectProjects lint"
    ]
  },
  "engines": {
    "node": ">=18",
    "npm": ">=8"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:vntrs/vntrs-boilerplates-backend-express.git"
  },
  "author": "VNTRS",
  "license": "See license in LICENSE.md",
  "bugs": {
    "url": "https://github.com/vntrs/vntrs-boilerplates-backend-express/issues"
  },
  "homepage": "https://github.com/vntrs/vntrs-boilerplates-backend-express#readme",
  "dependencies": {
    "@readme/json-schema-ref-parser": "^1.2.0",
    "@types/bcrypt": "^5.0.0",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.14",
    "@types/jsonwebtoken": "^9.0.1",
    "@types/node": "^18.15.12",
    "bcrypt": "^5.0.1",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.0",
    "module-alias": "^2.2.2",
    "tsconfig-paths": "^4.1.2",
    "typescript": "^5.0.4",
    "winston": "^3.3.3",
    "zod": "^3.19.1"
  },
  "devDependencies": {
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-decorators": "^7.18.6",
    "@babel/plugin-proposal-private-property-in-object": "^7.21.0",
    "@babel/preset-env": "^7.18.6",
    "@babel/preset-typescript": "^7.21.4",
    "@types/jest": "^29.4.0",
    "@types/supertest": "^2.0.12",
    "@typescript-eslint/eslint-plugin": "^5.52.0",
    "@typescript-eslint/parser": "^5.40.0",
    "babel-plugin-module-resolver": "^5.0.0",
    "babel-plugin-transform-typescript-metadata": "^0.3.2",
    "eslint": "^8.38.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-airbnb-base-typescript": "^1.1.0",
    "eslint-config-airbnb-typescript": "^17.0.0",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-import-resolver-typescript": "^3.5.5",
    "eslint-plugin-import": "^2.27.5",
    "jest": "^29.4.3",
    "jest-runner-eslint": "^2.0.0",
    "lint-staged": "^13.2.2",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "tsc-watch": "^4.6.2"
  }
}
